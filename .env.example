# Copy to .env and adjust. Never commit real secrets.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
APP_VERSION=0.1.0
DEFAULT_FROM_EMAIL=mahmoodi.maryam1993@gmail.com

POSTGRES_DB=trendpilot
POSTGRES_USER=trendpilot
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Auth (defaults shown): access/refresh lifetimes and throttle rates
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=7
THROTTLE_LOGIN_RATE=10/min
THROTTLE_REGISTER_RATE=5/hour
